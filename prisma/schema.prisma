// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  category              String
  brand                 String
  model                 String
  description           String
  specifications        String
  cash_price            Float
  installment_available Boolean  @default(true)
  installment_terms     String?
  images                String // JSON string of image URLs
  stock_status          String   @default("In Stock")
  created_at            DateTime @default(now())
}

model Category {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String?
  image       String?
}

model InstallmentApplication {
  id              String   @id @default(cuid())
  customer_name   String
  phone           String
  whatsapp        String?
  email           String?
  city            String
  branch          String
  product         String
  category        String
  estimated_price Float?
  purchase_type   String
  employment_type String
  monthly_income  Float
  business_name   String
  notes           String?
  status          String   @default("New")
  created_at      DateTime @default(now())
}

model ProductRequest {
  id              String   @id @default(cuid())
  customer_name   String
  phone           String
  whatsapp        String?
  product_name    String
  brand           String
  model           String?
  seller          String
  estimated_price Float?
  purchase_type   String
  branch          String
  notes           String?
  status          String   @default("New")
  created_at      DateTime @default(now())
}

model Branch {
  id       String @id @default(cuid())
  name     String
  address  String
  phone    String
  whatsapp String
  hours    String
  map_url  String?
}

model ContactLead {
  id         String   @id @default(cuid())
  name       String
  phone      String
  email      String?
  subject    String
  message    String
  status     String   @default("New")
  created_at DateTime @default(now())
}
